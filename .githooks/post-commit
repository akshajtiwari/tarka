#!/bin/sh
# Commit and push always go together: push every new commit straight away.
# If the push fails (offline, rejected), the commit is kept and we just warn.
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "HEAD" ]; then exit 0; fi   # detached HEAD (e.g. mid-rebase): skip
push() { git push --quiet origin "$branch" 2>/dev/null; }
push || { sleep 5; push; } || echo "post-commit: push failed, run 'git push' later" >&2
